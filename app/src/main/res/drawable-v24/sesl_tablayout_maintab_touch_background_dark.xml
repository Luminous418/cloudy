<?xml version="1.0" encoding="utf-8"?>
<!-- API 24+ override for the dark flash (harmless safety net; the library only ships
     a v24 variant for the light drawable). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="8dp"
    android:insetTop="8dp"
    android:insetRight="8dp"
    android:insetBottom="8dp">
    <shape android:shape="rectangle">
        <corners android:radius="@dimen/oui_float_nav_radius" />
        <solid android:color="@color/sesl_ripple_color_dark" />
    </shape>
</inset>