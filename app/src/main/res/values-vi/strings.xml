    <string name="dlg_flash_local_title">Flash %1$s?</string>
    <string name="dlg_flash_local_msg">Thao tác này sao chép ROM đã chọn vào /data rồi khởi động lại thiết bị vào recovery để áp dụng. Recovery tự áp dụng gói với các cơ chế bảo vệ riêng.\n\nHãy đảm bảo pin đã sạc và không ngắt quá trình khởi động lại. Chỉ tiếp tục nếu bạn hiểu rủi ro.</string>
