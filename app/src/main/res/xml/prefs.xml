<?xml version="1.0" encoding="utf-8"?>
<!-- SESL preference screen: rows render in the OneUI style via the tribalfs preference fork. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/prefs_general">

        <dev.cloudy.ota.ui.AppInfoPreference
            android:key="app_info" />

        <SwitchPreferenceCompat
            android:key="update_notifications"
            android:title="@string/prefs_update_notifications"
            android:summary="@string/prefs_update_notifications_summary"
            android:defaultValue="true" />

        <Preference
            android:key="credits"
            android:title="@string/prefs_credits"
            android:summary="@string/prefs_credits_summary" />

        <Preference
            android:key="advanced"
            android:title="@string/prefs_advanced"
            android:summary="@string/prefs_advanced_summary" />
    </PreferenceCategory>
</PreferenceScreen>
