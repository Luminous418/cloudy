<?xml version="1.0" encoding="utf-8"?>
<!-- Debug/testing convenience only: allow cleartext to the local loopback so the app
     can be pointed at a manifest served on the dev machine (adb reverse). All real
     update traffic stays HTTPS via the default base-config. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
