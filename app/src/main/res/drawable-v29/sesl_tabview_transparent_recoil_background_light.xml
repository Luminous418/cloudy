<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.graphics.drawable.SeslRecoilDrawable xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:seslRecoilColor="@color/sesl_ripple_color_light">
    <item android:id="@android:id/mask">
        <inset
            android:inset="12dp"
            android:insetTop="1.5dp"
            android:insetBottom="1.5dp">
            <androidx.appcompat.util.SeslShapeDrawable android:shape="rectangle">
                <solid android:color="@color/sesl_white" />
                <corners android:radius="@dimen/oui_float_nav_radius" />
            </androidx.appcompat.util.SeslShapeDrawable>
        </inset>
    </item>
</androidx.appcompat.graphics.drawable.SeslRecoilDrawable>
