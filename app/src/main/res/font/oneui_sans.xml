<?xml version="1.0" encoding="utf-8"?>
<!--
    Bundled One UI Sans family.

    Both the `android:` and `app:` attribute sets are declared: the framework reads
    `android:` (API 26+, which is our minSdk) and the SESL appcompat fork reads `app:`
    via ResourcesCompat. Declaring only one of them silently drops weight selection on
    whichever path the widget happens to use.

    The three TTFs all report usWeightClass 400 internally, so the weights below are
    what Android actually uses to pick a face - do not rely on the font metadata.
-->
<font-family
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:font="@font/oneui_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/oneui_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        android:font="@font/oneui_sans_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/oneui_sans_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />

    <font
        android:font="@font/oneui_sans_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/oneui_sans_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
