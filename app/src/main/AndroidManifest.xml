<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- ROM downloads must survive Cloudy being backgrounded (dataSync FGS on API 34+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Self-update: lets Cloudy hand its downloaded APK to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Only granted when Cloudy ships as a privileged/system app inside the ROM. -->
    <uses-permission android:name="android.permission.REBOOT" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECOVERY" tools:ignore="ProtectedPermissions" />

    <!-- oneui-icons / oneui-design raise minSdk; override so our minSdk 26 app builds. -->
    <uses-sdk tools:overrideLibrary="dev.oneuiproject.oneui" />

    <application
        android:name=".CloudyApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Cloudy"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:ignore="UnusedAttribute">

        <!-- OneUI dynamic (wallpaper) color theming. Provided by oneui-design. -->
        <meta-data android:name="SamsungBasicInteraction" android:value="SEP10" />
        <meta-data android:name="theming-meta" android:value="theming_meta_cloudy" />
        <meta-data android:name="theming-meta-xml" android:value="@xml/theming_meta_cloudy" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenLayout|screenSize"
            android:launchMode="singleTop">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ===== Samsung Settings dashboard injection =====
                 Indexes only when Cloudy is a privileged/system app in the ROM;
                 a sideloaded user app is silently ignored by the indexer. -->
            <intent-filter>
                <action android:name="com.samsung.settings.action.EXTRA_SETTINGS" />
            </intent-filter>
            <meta-data android:name="com.samsung.settings.category"
                android:value="com.samsung.settings.category.software_update" />
            <meta-data android:name="com.android.settings.title"
                android:resource="@string/settings_entry_title" />
            <meta-data android:name="com.android.settings.summary"
                android:resource="@string/settings_entry_summary" />
            <meta-data android:name="com.android.settings.icon"
                android:resource="@drawable/ic_cloudy_settings" />
            <meta-data android:name="com.samsung.settings.order" android:value="150" />
        </activity>

        <service android:name=".ota.CloudyRootService" android:exported="false"
            tools:ignore="Instantiatable" />

        <!-- Keeps ROM downloads alive while Cloudy is backgrounded; hosts the progress notification. -->
        <service
            android:name=".ota.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Exposes the downloaded APK to the system installer (self-update). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Background update notifications. -->
        <receiver
            android:name=".ota.UpdateAlarm$UpdateReceiver"
            android:exported="false" />
        <receiver
            android:name=".ota.UpdateAlarm$BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
